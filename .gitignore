# 忽略日志文件与目录
*.log
*.log.*
logs/

# 忽略特定目录
old/
config_back/
__pycache__/
.claude
test/*

# 忽略特定文件
config.toml
图像到图像（简易）.json
文生图（效果最好的一个）.json
.env
nul
008.jpg

# 忽略特定扩展名的文件（递归）
**/*.tmp

# 不忽略某个特定文件（例外规则）
#!important.log

#忽略ai生成的test文件
test_*
# 本地备份文件
*.bak_*
*.bak

# 本地工具缓存；必要的回归测试与依赖清单进入插件仓库。
!tests/test_*.py
# 本次本地回归用例不随发布提交。
/tests/test_draw_limit.py
/tests/test_doubao_prompt.py
.uv-cache/
.pytest_cache/
.pytest_tmp_*/
.venv/
.artifacts/

# 本地聊天设置与额度账本，不进入插件源码仓库。
data/

# 文档只保留 README.md；配置参考、更新说明和示例模板不入库。
*.md
!/README.md
*.example.toml
*.sample.toml
*.template.toml
/model_presets.toml
/scripts/update_config_reference.py
