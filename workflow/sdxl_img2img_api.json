{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "DreamShaperXL_Turbo_v2_1.safetensors"
    }
  },
  "10": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "Hilda_Series_ShowStyleV2_Pony.safetensors",
      "strength_model": 1.1,
      "strength_clip": 1.1
    }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "${image}"
    }
  },
  "12": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["11", 0],
      "vae": ["1", 2]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "score_9, score_8_up, score_7_up, hilda netflix background style, old storybook illustration, watercolor paper texture, hand painted, muted earthy colors, nordic fairytale, ${prompt}",
      "clip": ["10", 1]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "${negative_prompt}",
      "clip": ["10", 1]
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "${seed}",
      "steps": "${steps}",
      "cfg": "${cfg}",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": "${denoise}",
      "model": ["10", 0],
      "positive": ["4", 0],
      "negative": ["6", 0],
      "latent_image": ["12", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["1", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "maibot_art",
      "images": ["8", 0]
    }
  }
}
